generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id             Int    @id @default(autoincrement())
  name           String @unique
  normalizedName String @unique

  chainName String?
  category  String?
  location  String?
  notes     String?

  acceptedMethods MerchantPaymentAcceptance[]
  outlets         MerchantOutlet[]
  promotionDrafts PromotionDraft[]
  rewardRules     RewardRule[]
}

model MerchantOutlet {
  id             Int      @id @default(autoincrement())
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId     Int
  name           String
  normalizedName String
  location       String?

  promotionDrafts PromotionDraft[]
  rewardRules     RewardRule[]

  @@unique([merchantId, normalizedName])
}

model PaymentMethod {
  id             Int    @id @default(autoincrement())
  name           String @unique
  normalizedName String @unique
  type           String

  acceptedBy     MerchantPaymentAcceptance[]
  promotionDrafts PromotionDraft[]
  rewardRules    RewardRule[]
}

model MerchantPaymentAcceptance {
  id Int @id @default(autoincrement())

  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId     Int
  paymentMethod  PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodId Int

  rewardRules RewardRule[] @relation("AcceptedPaymentMethodRewardRules")

  @@unique([merchantId, paymentMethodId])
}

model RewardRule {
  id Int @id @default(autoincrement())

  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId     Int
  paymentMethod  PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodId Int
  acceptance     MerchantPaymentAcceptance @relation("AcceptedPaymentMethodRewardRules", fields: [merchantId, paymentMethodId], references: [merchantId, paymentMethodId], onDelete: Restrict)

  benefitType         String   @default("cashback")
  cashbackRate        Decimal?
  fixedDiscountAmount Int?
  amountThreshold     Int
  validityStart       DateTime
  validityEnd         DateTime
  promotionNote       String?
  sourceUrl           String?
  outlet              MerchantOutlet? @relation(fields: [outletId], references: [id], onDelete: Restrict)
  outletId            Int?
  promotionDraft      PromotionDraft?
}

model ImportRun {
  id Int @id @default(autoincrement())

  source       String
  status       String
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  errorMessage String?
  draftCount   Int      @default(0)

  drafts PromotionDraft[]
}

model PromotionDraft {
  id Int @id @default(autoincrement())

  importRun   ImportRun @relation(fields: [importRunId], references: [id], onDelete: Restrict)
  importRunId Int

  source            String
  sourceFingerprint String   @unique
  sourceUrl         String
  sourceTitle       String
  sourceContent     String
  fetchedAt         DateTime

  parsedCashbackRate           Decimal?
  parsedBenefitType            String?
  parsedFixedDiscountAmount    Int?
  parsedAmountThreshold        Int?
  parsedValidityStart          DateTime?
  parsedValidityEnd            DateTime?
  cashbackRateReviewed         Boolean @default(false)
  benefitTypeReviewed          Boolean @default(false)
  fixedDiscountAmountReviewed  Boolean @default(false)
  amountThresholdReviewed      Boolean @default(false)
  validityStartReviewed        Boolean @default(false)
  validityEndReviewed          Boolean @default(false)

  status String @default("pending_review")

  merchant       Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId     Int?
  paymentMethod  PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodId Int?

  benefitType         String   @default("cashback")
  cashbackRate        Decimal?
  fixedDiscountAmount Int?
  amountThreshold     Int?
  validityStart       DateTime?
  validityEnd         DateTime?
  promotionNote       String?
  outlet              MerchantOutlet? @relation(fields: [outletId], references: [id], onDelete: Restrict)
  outletId            Int?

  rewardRule   RewardRule? @relation(fields: [rewardRuleId], references: [id], onDelete: Restrict)
  rewardRuleId Int?        @unique

  reviewedAt      DateTime?
  rejectionReason String?
}
