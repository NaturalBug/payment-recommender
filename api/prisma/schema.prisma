// api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id             Int    @id @default(autoincrement())
  name           String @unique
  normalizedName String @unique

  chainName String?
  category  String?
  location  String?
  notes     String?

  acceptedMethods    MerchantPaymentAcceptance[]
  branches           MerchantBranch[]
  promotionDrafts    PromotionDraft[]
  originDrafts       PromotionDraftOriginMerchant[]
  excludedDrafts     PromotionDraftExcludedMerchant[]
  originPromotions   PromotionOriginMerchant[]
  excludedPromotions PromotionExcludedMerchant[]
  rewardRules        RewardRule[]
  issuerRestrictions MerchantIssuerRestriction[]
  cardExclusions     MerchantCardExclusion[]
}

model Outlet {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  normalizedName String  @unique
  location       String?

  branches         MerchantBranch[]
  originDrafts     PromotionDraftOriginOutlet[]
  originPromotions PromotionOriginOutlet[]
}

model MerchantBranch {
  id             Int      @id @default(autoincrement())
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId     Int
  name           String
  normalizedName String
  location       String?
  outlet         Outlet?  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  outletId       Int?

  promotionDrafts    PromotionDraft[]
  eligibleDrafts     PromotionDraftEligibleBranch[]
  excludedDrafts     PromotionDraftExcludedBranch[]
  eligiblePromotions PromotionEligibleBranch[]
  excludedPromotions PromotionExcludedBranch[]
  rewardRules        RewardRule[]

  @@unique([merchantId, normalizedName])
  @@map("MerchantOutlet")
}

model PaymentMethod {
  id             Int    @id @default(autoincrement())
  name           String @unique
  normalizedName String @unique
  type           String

  acceptedBy         MerchantPaymentAcceptance[]
  promotionDrafts    PromotionDraft[]
  draftSelections    PromotionDraftPaymentMethod[]
  promotions         PromotionPaymentMethod[]
  rewardRules        RewardRule[]
  cards              Card[]
  issuerRestrictions MerchantIssuerRestriction[]
}

model PaymentMethodType {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model MerchantPaymentAcceptance {
  id Int @id @default(autoincrement())

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId Int

  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodId Int

  rewardRules        RewardRule[]                @relation("AcceptedPaymentMethodRewardRules")
  issuerRestrictions MerchantIssuerRestriction[]

  @@unique([merchantId, paymentMethodId])
}

model RewardRule {
  id Int @id @default(autoincrement())

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId Int

  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodId Int

  acceptance MerchantPaymentAcceptance @relation("AcceptedPaymentMethodRewardRules", fields: [merchantId, paymentMethodId], references: [merchantId, paymentMethodId], onDelete: Restrict)

  benefitType         String          @default("cashback")
  cashbackRate        Decimal?
  fixedDiscountAmount Int?
  amountThreshold     Int
  validityStart       DateTime
  validityEnd         DateTime
  promotionNote       String?
  sourceUrl           String?
  branch              MerchantBranch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchId            Int?            @map("outletId")
  promotionDraft      PromotionDraft?
}

model ImportRun {
  id Int @id @default(autoincrement())

  source       String
  status       String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?
  draftCount   Int       @default(0)

  drafts PromotionDraft[]
}

model PromotionDraft {
  id Int @id @default(autoincrement())

  importRun   ImportRun @relation(fields: [importRunId], references: [id], onDelete: Restrict)
  importRunId Int

  source            String
  sourceFingerprint String   @unique
  sourceUrl         String
  sourceTitle       String
  sourceContent     String
  fetchedAt         DateTime

  parsedCashbackRate          Decimal?
  parsedBenefitType           String?
  parsedFixedDiscountAmount   Int?
  parsedAmountThreshold       Int?
  parsedValidityStart         DateTime?
  parsedValidityEnd           DateTime?
  cashbackRateReviewed        Boolean   @default(false)
  benefitTypeReviewed         Boolean   @default(false)
  fixedDiscountAmountReviewed Boolean   @default(false)
  amountThresholdReviewed     Boolean   @default(false)
  validityStartReviewed       Boolean   @default(false)
  validityEndReviewed         Boolean   @default(false)

  status String @default("pending_review")

  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId Int?

  originType      String?
  eligibilityType String?

  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodId Int?

  benefitType         String          @default("cashback")
  cashbackRate        Decimal?
  fixedDiscountAmount Int?
  amountThreshold     Int?
  validityStart       DateTime?
  validityEnd         DateTime?
  promotionNote       String?
  branch              MerchantBranch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchId            Int?            @map("outletId")

  rewardRule   RewardRule? @relation(fields: [rewardRuleId], references: [id], onDelete: Restrict)
  rewardRuleId Int?        @unique
  promotion    Promotion?

  originMerchants   PromotionDraftOriginMerchant[]
  originOutlets     PromotionDraftOriginOutlet[]
  eligibleBranches  PromotionDraftEligibleBranch[]
  excludedMerchants PromotionDraftExcludedMerchant[]
  excludedBranches  PromotionDraftExcludedBranch[]
  paymentMethods    PromotionDraftPaymentMethod[]
  issuers           PromotionDraftIssuer[]
  cards             PromotionDraftCard[]

  reviewedAt      DateTime?
  rejectionReason String?
}

model PromotionDraftOriginMerchant {
  draft      PromotionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId    Int
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId Int

  @@id([draftId, merchantId])
}

model PromotionDraftOriginOutlet {
  draft    PromotionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId  Int
  outlet   Outlet         @relation(fields: [outletId], references: [id], onDelete: Restrict)
  outletId Int

  @@id([draftId, outletId])
}

model PromotionDraftPaymentMethod {
  draft           PromotionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId         Int
  paymentMethod   PaymentMethod  @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodId Int

  @@id([draftId, paymentMethodId])
}

model PromotionDraftEligibleBranch {
  draft    PromotionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId  Int
  branch   MerchantBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchId Int

  @@id([draftId, branchId])
}

model PromotionDraftExcludedMerchant {
  draft      PromotionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId    Int
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId Int

  @@id([draftId, merchantId])
}

model PromotionDraftExcludedBranch {
  draft    PromotionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId  Int
  branch   MerchantBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchId Int

  @@id([draftId, branchId])
}

model Promotion {
  id                  Int            @id @default(autoincrement())
  sourceDraft         PromotionDraft @relation(fields: [sourceDraftId], references: [id], onDelete: Restrict)
  sourceDraftId       Int            @unique
  originType          String
  eligibilityType     String
  benefitType         String
  cashbackRate        Decimal?
  fixedDiscountAmount Int?
  amountThreshold     Int
  validityStart       DateTime
  validityEnd         DateTime
  promotionNote       String?
  sourceUrl           String
  sourceTitle         String
  createdAt           DateTime       @default(now())

  originMerchants   PromotionOriginMerchant[]
  originOutlets     PromotionOriginOutlet[]
  paymentMethods    PromotionPaymentMethod[]
  eligibleBranches  PromotionEligibleBranch[]
  excludedMerchants PromotionExcludedMerchant[]
  excludedBranches  PromotionExcludedBranch[]
  issuers           PromotionIssuer[]
  cards             PromotionCard[]
}

model PromotionOriginMerchant {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId Int
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId  Int

  @@id([promotionId, merchantId])
}

model PromotionOriginOutlet {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId Int
  outlet      Outlet    @relation(fields: [outletId], references: [id], onDelete: Restrict)
  outletId    Int

  @@id([promotionId, outletId])
}

model PromotionPaymentMethod {
  promotion       Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId     Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodId Int

  @@id([promotionId, paymentMethodId])
}

model PromotionEligibleBranch {
  promotion   Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId Int
  branch      MerchantBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchId    Int

  @@id([promotionId, branchId])
}

model PromotionExcludedMerchant {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId Int
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantId  Int

  @@id([promotionId, merchantId])
}

model PromotionExcludedBranch {
  promotion   Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId Int
  branch      MerchantBranch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchId    Int

  @@id([promotionId, branchId])
}

model Issuer {
  id             Int    @id @default(autoincrement())
  name           String @unique
  normalizedName String @unique

  cards                Card[]
  merchantRestrictions MerchantIssuerRestriction[]
  draftScopes          PromotionDraftIssuer[]
  promotionScopes      PromotionIssuer[]
}

// kind is one of: credit, debit, prepaid
model Card {
  id   Int    @id @default(autoincrement())
  name String
  kind String

  issuer    Issuer        @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  issuerId  Int
  network   PaymentMethod @relation(fields: [networkId], references: [id], onDelete: Restrict)
  networkId Int

  merchantExclusions MerchantCardExclusion[]
  draftScopes        PromotionDraftCard[]
  promotionScopes    PromotionCard[]

  @@unique([issuerId, name])
}

model MerchantIssuerRestriction {
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId Int
  network    PaymentMethod @relation(fields: [networkId], references: [id], onDelete: Restrict)
  networkId  Int
  issuer     Issuer        @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  issuerId   Int

  acceptance MerchantPaymentAcceptance @relation(fields: [merchantId, networkId], references: [merchantId, paymentMethodId], onDelete: Restrict)

  @@id([merchantId, networkId, issuerId])
}

model MerchantCardExclusion {
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId Int
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Restrict)
  cardId     Int

  @@id([merchantId, cardId])
}

model PromotionDraftIssuer {
  draft    PromotionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId  Int
  issuer   Issuer         @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  issuerId Int

  @@id([draftId, issuerId])
}

model PromotionDraftCard {
  draft   PromotionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId Int
  card    Card           @relation(fields: [cardId], references: [id], onDelete: Restrict)
  cardId  Int

  @@id([draftId, cardId])
}

model PromotionIssuer {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId Int
  issuer      Issuer    @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  issuerId    Int

  @@id([promotionId, issuerId])
}

model PromotionCard {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId Int
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Restrict)
  cardId      Int

  @@id([promotionId, cardId])
}
